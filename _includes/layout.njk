<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% if module %}
    {% set _title = module.title + " — Evolve Poker Academy" %}
    {% set _desc = module.description | truncate(160) %}
  {% elif title %}
    {% set _title = title %}
    {% set _desc = description %}
  {% else %}
    {% set _title = texts[page_key].meta_title %}
    {% set _desc = texts[page_key].meta_desc %}
  {% endif %}

  <title>{{ _title }}</title>
  <meta name="description" content="{{ _desc }}">
  <meta name="robots" content="index, follow">

  <!-- Canonical -->
  <link rel="canonical" href="{{ texts.site.url }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:locale"      content="fr_FR">
  <meta property="og:site_name"   content="{{ texts.site.name }}">
  <meta property="og:title"       content="{{ _title }}">
  <meta property="og:description" content="{{ _desc }}">
  <meta property="og:url"         content="{{ texts.site.url }}{{ page.url }}">
  <meta property="og:image"       content="{{ texts.site.url }}/assets/images/og-default.png">
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ _title }}">
  <meta name="twitter:description" content="{{ _desc }}">
  <meta name="twitter:image"       content="{{ texts.site.url }}/assets/images/og-default.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">

  <link rel="icon" href="/assets/images/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/images/favicon-96x96.png" sizes="96x96" type="image/png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href="/assets/css/style.css">

  <!-- Gestion consentement cookies (Tarteaucitron) + Google Analytics -->
  <!-- defer : le script ne bloque plus le rendu ; l'init attend DOMContentLoaded pour s'assurer que tarteaucitron est bien chargé (les scripts defer s'exécutent avant cet événement, dans l'ordre) -->
  <script src="https://cdn.jsdelivr.net/npm/tarteaucitronjs@1/tarteaucitron.min.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      tarteaucitron.init({
        "privacyUrl": "/cgu/#privacy",
        "orientation": "bottom",
        "DenyAllCta": true,
        "AcceptAllCta": true,
        "highPrivacy": true,
        "removeCredit": false,
        "useExternalCss": false,
        "useExternalJs": false
      });
      tarteaucitron.user.gtagUa = 'G-6Q1X0GBT65';
      (tarteaucitron.job = tarteaucitron.job || []).push('gtag');
    });
  </script>
</head>
<body>

  <header class="nav">
    <div class="container">
      <nav class="nav__inner">
        <a href="/index.html" class="nav__logo">
          <img src="/assets/images/logo.webp" alt="Evolve Poker" class="nav__logo-img" width="156" height="156">
        </a>
        <ul class="nav__links">
          <li class="nav__item">
            <button class="nav__link">Apps <span class="nav__link-arrow">▾</span></button>
            <div class="nav__dropdown">
              <a href="#" class="nav__dropdown-store">
                <div class="nav__dropdown-store__icon">&#xF8FF;</div>
                <div class="nav__dropdown-store__text">
                  <span class="nav__dropdown-store__sub">Télécharger sur l'</span>
                  <span class="nav__dropdown-store__name">App Store</span>
                </div>
              </a>
              <div class="nav__dropdown-divider"></div>
              <a href="#" class="nav__dropdown-store">
                <div class="nav__dropdown-store__icon">▶</div>
                <div class="nav__dropdown-store__text">
                  <span class="nav__dropdown-store__sub">Disponible sur</span>
                  <span class="nav__dropdown-store__name">Google Play</span>
                </div>
              </a>
            </div>
          </li>
          <li class="nav__item">
            <a href="/index.html" class="nav__link{% if activeNav == 'home' %} nav__link--active{% endif %}">Home</a>
          </li>
          <li class="nav__item">
            <a href="/pages/academy/academy.html" class="nav__link{% if activeNav == 'academy' %} nav__link--active{% endif %}">Academy</a>
          </li>
          <li class="nav__item">
            <a href="/pages/features/features.html" class="nav__link{% if activeNav == 'features' %} nav__link--active{% endif %}">Fonctionnalités</a>
          </li>
          <li class="nav__item">
            <a href="/pages/lasuite/lasuite.html" class="nav__link{% if activeNav == 'lasuite' %} nav__link--active{% endif %}">La suite</a>
          </li>
          <li class="nav__item">
            <button class="nav__link{% if activeNav == 'evolve' %} nav__link--active{% endif %}">Le projet <span class="nav__link-arrow">▾</span></button>
            <div class="nav__dropdown">
              <a href="/cgu/#evolve" class="nav__dropdown-link">Le projet</a>
              <a href="/cgu/#risques" class="nav__dropdown-link">Risques du Poker</a>
              <a href="/cgu/#aide" class="nav__dropdown-link">Aide aux inscriptions</a>
              <div class="nav__dropdown-divider"></div>
              <a href="/cgu/#terms" class="nav__dropdown-link">Conditions d'utilisation</a>
              <a href="/cgu/#privacy" class="nav__dropdown-link">Confidentialité</a>
              <a href="/cgu/#faq" class="nav__dropdown-link">FAQ</a>
            </div>
          </li>
          <li class="nav__item">
            <a href="/pages/contact/contact.html" class="nav__link{% if activeNav == 'contact' %} nav__link--active{% endif %}">Contact</a>
          </li>
        </ul>
        <div class="nav__actions">
          <div class="nav__item">
            <button class="nav__globe-btn" aria-label="Changer de langue"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></button>
            <div class="nav__dropdown nav__dropdown--right">
              <button class="nav__dropdown-lang nav__dropdown-lang--active"><span class="nav__dropdown-lang__flag">🇫🇷</span> Français</button>
              <button class="nav__dropdown-lang"><span class="nav__dropdown-lang__flag">🇬🇧</span> English</button>
            </div>
          </div>
          <button class="nav__burger" id="nav-burger" aria-label="Ouvrir le menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="nav-overlay"></div>

  <!-- Mobile drawer -->
  <div class="nav-drawer" id="nav-drawer" aria-label="Menu navigation">
    <div class="nav-drawer__header">
      <a href="/index.html">
        <img src="/assets/images/logo.webp" alt="Evolve Poker" class="nav-drawer__logo" width="36" height="36">
      </a>
      <button class="nav-drawer__close" id="nav-drawer-close" aria-label="Fermer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <ul class="nav-drawer__links">
      <li><a href="/index.html" class="nav-drawer__link">Home</a></li>
      <li><a href="/pages/academy/academy.html" class="nav-drawer__link">Academy</a></li>
      <li><a href="/pages/features/features.html" class="nav-drawer__link">Fonctionnalités</a></li>
      <li><a href="/pages/lasuite/lasuite.html" class="nav-drawer__link">La suite</a></li>
      <li><a href="/cgu/" class="nav-drawer__link">Le projet</a></li>
      <li><a href="/pages/contact/contact.html" class="nav-drawer__link">Contact</a></li>
    </ul>
    <div class="nav-drawer__stores">
      <a href="#" class="btn-store">
        <span class="btn-store__icon">&#xF8FF;</span>
        <span class="btn-store__text">
          <span class="btn-store__sub">Télécharger sur l'</span>
          <span class="btn-store__name">App Store</span>
        </span>
      </a>
      <a href="#" class="btn-store">
        <span class="btn-store__icon">▶</span>
        <span class="btn-store__text">
          <span class="btn-store__sub">Disponible sur</span>
          <span class="btn-store__name">Google Play</span>
        </span>
      </a>
    </div>
  </div>

  {{ content | safe }}

  <footer class="footer">
    <div class="container">

      <div class="footer__bar">
        <a href="/index.html">
          <img src="/assets/images/logo.webp" alt="Evolve Poker" class="footer__logo-img" width="144" height="144">
        </a>
        <div class="footer__center">
          <p class="footer__beta-text">Version bêta — projet solo, né d'une passion pour le poker et d'un outil qui n'existait pas. Chaque retour compte.</p>
          <ul class="footer__links">
